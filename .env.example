# Адрес сайта после подключения домена (используется в canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://aivaclinic.kz

# Доставка заявок с формы записи. Если ничего не задано — после проверки формы
# пациенту предлагается отправить заявку в WhatsApp клиники.
# Вариант 1: Telegram-бот (создать у @BotFather, добавить в чат администраторов)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Вариант 2: любой веб-хук (CRM, Google Apps Script, n8n и т. п.) — получит JSON заявки
BOOKING_WEBHOOK_URL=
